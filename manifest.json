{
  "name": "newsalat",
  "short_name": "newsalat",
  "description": "Finance Bill, protest and agriculture news alerts",
  "id": "/",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "display_override": ["window-controls-overlay", "tabbed"],
  "orientation": "portrait",
  "background_color": "#eef2ef",
  "theme_color": "#0f5c3a",
  "lang": "en",
  "categories": ["news"],
  "launch_handler": {
    "client_mode": "focus-existing"
  },
  "protocol_handlers": [
    {
      "protocol": "web+newsalat",
      "url": "/?article=%s"
    }
  ],
  "share_target": {
    "action": "/share",
    "method": "GET",
    "enctype": "application/x-www-form-urlencoded",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url"
    }
  },
  "edge_side_panel": {
    "preferred_width": 400
  },
  "note_taking": {
    "new_note_url": "/new-note"
  },
  "widgets": [
    {
      "name": "Latest News",
      "short_name": "News",
      "description": "Latest headlines from Newsalat",
      "tag": "latest-news",
      "template": "latest-news",
      "ms_ac_template": "widgets/latest-news.json",
      "data": "widgets/latest-news-data.json",
      "type": "application/json",
      "screenshots": [
        {
          "src": "/icons/widget-screenshot.png",
          "sizes": "540x240",
          "label": "Latest News Widget"
        }
      ],
      "icons": [
        {
          "src": "/icons/icon-192.png",
          "sizes": "192x192"
        }
      ],
      "auth": false,
      "update": 86400
    }
  ],
  "icons": [
    {
      "src": "/icons/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icons/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icons/icon-512-maskable.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "screenshots": [
    {
      "src": "/screenshots/desktop.png",
      "sizes": "1280x720",
      "type": "image/png",
      "form_factor": "wide",
      "label": "Newsalat on Desktop"
    },
    {
      "src": "/screenshots/mobile.png",
      "sizes": "390x844",
      "type": "image/png",
      "form_factor": "narrow",
      "label": "Newsalat on Mobile"
    }
  ]
}
